{
  "manifest_version": 3,
  "name": "Image Converter",
  "description": "Convert and download images in multiple formats (PNG, JPG, WEBP, AVIF) with ease.",
  "version": "1.2.0",
  "permissions": [],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  }
}
