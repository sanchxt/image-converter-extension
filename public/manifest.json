{
  "manifest_version": 3,
  "name": "Image Converter",
  "description": "The most elegant image converter with beautiful UI. Convert images to PNG, JPG, WebP, and AVIF formats in bulk with a single click.",
  "version": "1.3.0",
  "permissions": [],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  }
}
